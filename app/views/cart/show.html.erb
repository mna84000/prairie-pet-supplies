<div class="py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Your Shopping Cart</h1>

    <%= link_to "Continue Shopping",
                products_path,
                class: "btn btn-outline-secondary" %>
  </div>

  <% if @cart_items.any? %>
    <% total = 0 %>

    <div class="row g-4">
      <div class="col-lg-8">
        <% @cart_items.each do |item| %>
          <% product = item[:product] %>
          <% quantity = item[:quantity] %>
          <% subtotal = product.price * quantity %>
          <% total += subtotal %>

          <div class="card shadow-sm mb-3">
            <div class="card-body">
              <div class="row align-items-center g-3">
                <div class="col-md-3 text-center">
                  <% if product.image.attached? %>
                    <%= image_tag product.image.variant(resize_to_limit: [150, 150]),
                                  class: "img-fluid rounded",
                                  alt: product.name %>
                  <% end %>
                </div>

                <div class="col-md-9">
                  <h2 class="h4"><%= product.name %></h2>

                  <p class="mb-1">
                    <strong>Category:</strong>
                    <%= product.category.name %>
                  </p>

                  <p class="mb-3">
                    <strong>Price:</strong>
                    <%= number_to_currency(product.price) %>
                  </p>

                  <%= form_with url: update_cart_path(product),
                                method: :patch,
                                local: true,
                                class: "row g-2 align-items-end mb-3" do |form| %>

                    <div class="col-sm-4">
                      <%= form.label :quantity,
                                     "Quantity",
                                     class: "form-label" %>

                      <%= form.number_field :quantity,
                                            value: quantity,
                                            min: 1,
                                            class: "form-control" %>
                    </div>

                    <div class="col-sm-auto">
                      <%= form.submit "Update Quantity",
                                      class: "btn btn-primary" %>
                    </div>
                  <% end %>

                  <%= button_to "Remove Item",
                                remove_from_cart_path(product),
                                method: :delete,
                                class: "btn btn-outline-danger btn-sm",
                                data: {
                                  turbo_confirm: "Remove this item from your cart?"
                                } %>

                  <p class="mt-3 mb-0">
                    <strong>
                      Subtotal:
                      <%= number_to_currency(subtotal) %>
                    </strong>
                  </p>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <div class="col-lg-4">
        <div class="card shadow-sm">
          <div class="card-body">
            <h2 class="h4">Order Summary</h2>

            <p class="fs-5">
              <strong>
                Cart Total:
                <%= number_to_currency(total) %>
              </strong>
            </p>

            <%= link_to "Proceed to Checkout",
                        checkout_path,
                        class: "btn btn-success w-100" %>
          </div>
        </div>
      </div>
    </div>

  <% else %>
    <div class="alert alert-info">
      Your shopping cart is empty.
    </div>

    <%= link_to "Browse Products",
                products_path,
                class: "btn btn-primary" %>
  <% end %>
</div>