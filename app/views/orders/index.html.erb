<div class="py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>My Orders</h1>

    <%= link_to "Continue Shopping",
                products_path,
                class: "btn btn-outline-secondary" %>
  </div>

  <% if @orders.any? %>
    <div class="row g-4">
      <% @orders.each do |order| %>
        <div class="col-12">
          <div class="card shadow-sm">
            <div class="card-body">
              <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3">
                <div>
                  <h2 class="h4 mb-1">
                    Order #<%= order.id %>
                  </h2>

                  <p class="text-muted mb-0">
                    <%= order.created_at.strftime("%B %d, %Y at %I:%M %p") %>
                  </p>
                </div>

                <span class="badge bg-secondary mt-2 mt-md-0">
                  <%= order.status.to_s.titleize %>
                </span>
              </div>

              <h3 class="h5">Products</h3>

              <div class="table-responsive mb-3">
                <table class="table table-sm align-middle">
                  <thead>
                    <tr>
                      <th>Product</th>
                      <th>Quantity</th>
                      <th>Unit Price</th>
                      <th>Line Total</th>
                    </tr>
                  </thead>

                  <tbody>
                    <% order.order_items.each do |item| %>
                      <tr>
                        <td><%= item.product.name %></td>
                        <td><%= item.quantity %></td>
                        <td><%= number_to_currency(item.unit_price) %></td>
                        <td>
                          <%= number_to_currency(
                                item.unit_price * item.quantity
                              ) %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>

              <div class="row g-2">
                <div class="col-6 col-md-2">
                  <strong>Subtotal:</strong><br>
                  <%= number_to_currency(order.subtotal) %>
                </div>

                <div class="col-6 col-md-2">
                  <strong>GST:</strong><br>
                  <%= number_to_currency(order.gst) %>
                </div>

                <div class="col-6 col-md-2">
                  <strong>PST:</strong><br>
                  <%= number_to_currency(order.pst) %>
                </div>

                <div class="col-6 col-md-2">
                  <strong>HST:</strong><br>
                  <%= number_to_currency(order.hst) %>
                </div>

                <div class="col-12 col-md-4">
                  <strong>Grand Total:</strong><br>
                  <span class="fs-5">
                    <%= number_to_currency(order.total) %>
                  </span>
                </div>
              </div>

              <div class="mt-3">
                <%= link_to "View Order Details",
                            order_path(order),
                            class: "btn btn-primary" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info">
      You have not placed any orders yet.
    </div>

    <%= link_to "Browse Products",
                products_path,
                class: "btn btn-primary" %>
  <% end %>
</div>