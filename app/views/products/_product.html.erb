<div>
  <% if product.image.attached? %>
    <%= image_tag product.image, width: 150 %>
  <% end %>

  <h3>
    <%= link_to product.name, product_path(product) %>
  </h3>

  <p><%= product.description %></p>
  <p>Category: <%= product.category.name %></p>
  <p>Price: <%= number_to_currency(product.price) %></p>
</div>

<hr>